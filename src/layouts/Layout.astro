---
const {
	title = 'Gage DeZoort · Particle Physics & Machine Learning',
	description = 'Machine learning researcher and physicist specializing in graph neural networks, graph transformers, and scalable deep learning for scientific data.',
	ogImage = '/images/headshot-walkway.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="particle-field" aria-hidden="true">
			<span class="orbit orbit--one">
				<span class="orbit__particle"></span>
				<span class="orbit__particle"></span>
				<span class="orbit__particle"></span>
			</span>
			<span class="orbit orbit--two">
				<span class="orbit__particle"></span>
				<span class="orbit__particle"></span>
				<span class="orbit__particle"></span>
			</span>
		</div>
		<div class="page-shell">
			<nav class="site-nav" aria-label="Primary">
				<a class="site-nav__mark" href="/">Gage DeZoort</a>
				<ul>
					<li><a href="#work">Work</a></li>
					<li><a href="#teaching">Teaching</a></li>
					<li><a href="#contact">Contact</a></li>
				</ul>
			</nav>
			<slot />
			<footer class="site-footer">
				<p>Gage DeZoort</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	:root {
		color-scheme: dark;
		--bg: #11131b;
		--surface: rgba(22, 26, 36, 0.9);
		--surface-strong: rgba(27, 31, 44, 0.94);
		--text: #f3f4f9;
		--text-soft: #c4c9d7;
		--accent: #f2b26c;
		--accent-soft: rgba(242, 178, 108, 0.24);
		--border: rgba(255, 255, 255, 0.08);
		--max-width: 1120px;
	}

	html {
		background: var(--bg);
		scroll-behavior: smooth;
	}

	[id] {
		scroll-margin-top: 1.25rem;
	}

	body {
		margin: 0;
		min-height: 100vh;
		position: relative;
		font-family: 'Plus Jakarta Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
		color: var(--text);
		background: linear-gradient(160deg, #11131b 0%, #141922 40%, #1a202a 100%);
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(220px 280px at 12% 14%, rgba(242, 178, 108, 0.1), transparent 70%),
			radial-gradient(280px 220px at 88% 78%, rgba(116, 153, 214, 0.1), transparent 72%);
		opacity: 0.45;
		z-index: 0;
	}

	body::after {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image: radial-gradient(360px 300px at 50% 8%, rgba(94, 109, 166, 0.2), transparent 70%);
		opacity: 0.18;
		z-index: 0;
	}

	.particle-field {
		position: fixed;
		inset: -20vh -20vw;
		z-index: 0;
		pointer-events: none;
	}

	.orbit {
		--size: min(120vw, 1180px);
		position: absolute;
		display: block;
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		border: 1px solid rgba(242, 178, 108, 0.32);
		box-shadow: 0 0 80px rgba(242, 178, 108, 0.1);
	}

	.orbit--one {
		top: -22%;
		left: -18%;
	}

	.orbit--two {
		--size: min(95vw, 900px);
		top: 36%;
		left: 46%;
		border-color: rgba(116, 153, 214, 0.32);
		box-shadow: 0 0 80px rgba(116, 153, 214, 0.1);
	}

	.orbit__particle {
		--start: 18deg;
		position: absolute;
		top: 50%;
		left: 50%;
		width: 9px;
		height: 9px;
		margin: -4.5px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.95), rgba(242, 178, 108, 0.45));
		box-shadow: 0 0 18px rgba(242, 178, 108, 0.7);
		animation: particle-orbit 52s linear infinite;
	}

	.orbit__particle:nth-child(2) {
		--start: 138deg;
	}

	.orbit__particle:nth-child(3) {
		--start: 258deg;
	}

	.orbit--two .orbit__particle {
		background: radial-gradient(circle, rgba(255, 255, 255, 0.95), rgba(116, 153, 214, 0.5));
		box-shadow: 0 0 18px rgba(116, 153, 214, 0.65);
		animation-duration: 68s;
		animation-direction: reverse;
	}

	@keyframes particle-orbit {
		from {
			transform: rotate(var(--start)) translateX(calc(var(--size) / 2));
		}
		to {
			transform: rotate(calc(var(--start) + 360deg)) translateX(calc(var(--size) / 2));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit__particle {
			animation: none;
			transform: rotate(var(--start)) translateX(calc(var(--size) / 2));
		}

		html {
			scroll-behavior: auto;
		}
	}

	.page-shell {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		padding: clamp(1.1rem, 2.4vw, 2.2rem) clamp(1.25rem, 6vw, 3.5rem) clamp(1.75rem, 3vw, 3rem);
	}

	.site-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		max-width: var(--max-width);
		width: 100%;
		margin: 0 auto 0.4rem;
		padding: 0.2rem 0.35rem 0.85rem;
	}

	.site-nav__mark {
		font-family: inherit;
		font-weight: 600;
		font-size: 0.98rem;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.site-nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.35rem 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-nav a {
		color: var(--text-soft);
		font-size: 0.88rem;
		font-weight: 500;
	}

	.site-nav a:hover,
	.site-nav a:focus-visible {
		color: var(--accent);
	}

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		max-width: var(--max-width);
		width: 100%;
		margin: 0 auto;
		padding: 0.4rem 0.35rem 0;
		color: rgba(196, 201, 215, 0.7);
		font-size: 0.82rem;
	}

	a {
		color: var(--accent);
		text-decoration: none;
	}

	a:hover,
	a:focus-visible {
		color: #fce0b1;
	}

	p {
		margin: 0;
		line-height: 1.7;
	}

	.section-card {
		background: var(--surface);
		border-radius: 26px;
		border: 1px solid var(--border);
		box-shadow: 0 12px 28px rgba(8, 12, 20, 0.18);
		padding: clamp(1.85rem, 3vw, 2.6rem);
		position: relative;
	}

	.section-title {
		margin: 0 0 1rem;
		font-family: inherit;
		font-size: clamp(1.7rem, 2.5vw, 2.15rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.section-lede {
		margin: 0 0 1.35rem;
		color: var(--text-soft);
		font-size: 1rem;
		line-height: 1.7;
	}

	@media (max-width: 640px) {
		.site-nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.55rem;
		}

		.site-nav ul {
			justify-content: flex-start;
		}
	}
</style>
