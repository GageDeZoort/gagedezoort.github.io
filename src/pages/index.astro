---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Gage DeZoort · Particle Physics & Machine Learning';
const description =
	'Machine learning researcher and physicist specializing in graph neural networks, graph transformers, and scalable deep learning for scientific data.';

const currentWork = {
	title: 'Coupled Particle-Edge Networks',
	url: 'https://indico.nbi.ku.dk/event/2253/contributions/17099/',
	citation: 'Plenary talk, HAMLET-PHYSICS 2026',
	lede:
		'I am extending hyperparameter transfer parameterizations from standard GNNs to models with attention and edge features — Coupled Particle-Edge Networks (CPENs). The aim is the same as the published transfer work: tune a small proxy, then scale.',
	applications: [
		{
			title: 'Jet classification',
			description: 'Tagging collider jets with CPEN architectures that inherit learning rates from smaller, cheaper-to-tune models.',
		},
		{
			title: 'Stellar streams',
			description: 'Identifying stellar streams in astronomical surveys with the same transfer rules.',
		},
	],
};

const featured = {
	year: '2026',
	title: 'Hyperparameter Transfer in Graph Neural Networks',
	url: 'https://arxiv.org/abs/2607.05017',
	citation: 'G. DeZoort and B. Hanin, arXiv:2607.05017 (2026)',
	description: 'A recipe for scaling up GNNs using a hyperparameter transfer parameterization.',
	image: '/images/hp-transfer-qm9.jpg',
	imageAlt:
		'QM9 results showing learning-rate transfer across GNN sizes and improving train loss and validation MAE as models scale',
};

const selectedPapers = [
	{
		year: '2025',
		title: 'Principles for Initialization and Architecture Selection in Graph Neural Networks',
		url: 'https://doi.org/10.1137/23M1600621',
		citation: 'G. DeZoort and B. Hanin, SIAM Journal on Mathematics of Data Science 7, 1 (2025)',
		description:
			'Training deep GNNs through careful initialization, mitigating oversmoothing, and overcoming correlation collapse.',
		image: '/images/gnn-init-ablation.jpg',
		imageAlt:
			'Test accuracy versus depth on Cora and stochastic block models, comparing vanilla GNNs with residual aggregation and residual connections',
		figureClass: 'review-card__figure--plot',
	},
	{
		year: '2023',
		title: 'Graph Neural Networks at the Large Hadron Collider',
		url: 'https://doi.org/10.1038/s42254-023-00569-0',
		citation: 'G. DeZoort et al., Nature Reviews Physics 5, 281 (2023)',
		description: 'Surveying state of the art GNNs applied to a broad range of particle physics tasks.',
		image: '/images/gnn-lhc-figure.jpg',
		imageAlt: 'Detector cross-section showing particle tracks, tracker hits, and calorimeter layers',
	},
];

const highlights = [
	{
		year: '2025',
		title: 'Heavy pseudoscalar Higgs search (A → Zh → ℓℓττ)',
		url: 'https://doi.org/10.1007/JHEP10%282025%29074',
		citation: 'CMS Collaboration, Journal of High Energy Physics 10, 074 (2025)',
		description: 'Search for a heavy pseudoscalar Higgs boson in the full CMS Run 2 dataset.',
	},
	{
		year: '2021',
		title: 'Charged particle tracking via interaction networks',
		url: 'https://doi.org/10.1007/s41781-021-00073-z',
		citation: 'G. DeZoort et al., Computing and Software for Big Science 5, 26 (2021)',
		description: 'Charged particle tracking via edge-classifying GNNs.',
	},
];

const connections = [
	{ label: 'Email', href: 'mailto:jdezoort@princeton.edu' },
	{ label: 'Scholar', href: 'https://scholar.google.com/citations?user=CFIJTBAAAAAJ' },
	{ label: 'GitHub', href: 'https://github.com/GageDeZoort' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/gagedezoort' },
];

const tutorialLinks = [
	{
		year: '2025',
		title: 'Crash Course in Practical ML',
		url: 'https://github.com/GageDeZoort/intro_ml_uci',
		description:
			'A three-day UCI crash course (100+ attendees) on practical ML, taught as a School of Physical Sciences Visiting Fellow.',
		image: '/images/crash-course-lecture-1.jpg',
		imageAlt: 'Gage DeZoort teaching a practical machine learning crash course at UC Irvine',
	},
	{
		year: '2022–2025',
		title: 'Graph Neural Networks for Your Research',
		url: 'https://github.com/GageDeZoort/prc_gnn_tutorial',
		description:
			'A recurring Princeton Research Computing workshop on applying graph neural networks to scientific research.',
		image: '/images/princeton-intro-ml.jpg',
		imageAlt: 'Students following along during the Princeton graph neural networks workshop',
	},
];

const instagramLink = 'https://www.instagram.com/gagedezoort.music/';
const creativePhotos = [
	{ src: '/images/gig-1.jpg', alt: 'Gage DeZoort performing live on guitar', className: 'creative-card__photo creative-card__photo--one' },
	{ src: '/images/gig-2.jpg', alt: 'Gage DeZoort playing a progressive metal set', className: 'creative-card__photo creative-card__photo--two' },
	{ src: '/images/gig-3.jpg', alt: 'Gage DeZoort playing bass under stage lights', className: 'creative-card__photo creative-card__photo--three' },
];
---

<Layout title={pageTitle} description={description}>
	<header class="hero">
		<div class="hero__text">
			<h1 class="hero__name">Gage DeZoort</h1>
			<p class="hero__role">AI × Physics Postdoc @ Princeton</p>
			<p class="hero__bio">
				Machine learning researcher and physicist specializing in graph neural networks, graph transformers, and
				scalable deep learning for scientific data. I build principled architectures with an emphasis on
				optimization stability, hyperparameter transfer, and robust inference, with applications in collider
				physics and astronomy.
			</p>
			<div class="hero__actions">
				<a class="button button--primary" href="/docs/Gage-DeZoort-Resume.pdf" target="_blank" rel="noreferrer">
					Resume
				</a>
				<a class="button button--ghost" href="/docs/Gage-DeZoort-CV.pdf" target="_blank" rel="noreferrer">
					CV
				</a>
				<a class="button button--ghost" href="mailto:jdezoort@princeton.edu">Email</a>
			</div>
		</div>
		<div class="hero__portrait">
			<div class="hero__frame">
				<img
					src="/images/headshot-walkway.jpg"
					alt="Portrait of Gage DeZoort"
					width="430"
					height="574"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>
	</header>

	<main class="content">
		<section class="section-card ongoing-card" id="ongoing">
			<h2 class="section-title">Current Work</h2>
			<h3 class="ongoing-card__title">{currentWork.title}</h3>
			<p class="ongoing-card__lede">{currentWork.lede}</p>
			<div class="ongoing-card__apps">
				{currentWork.applications.map((app) => (
					<div>
						<h4>{app.title}</h4>
						<p>{app.description}</p>
					</div>
				))}
			</div>
			<p class="ongoing-card__link">
				<a href={currentWork.url} target="_blank" rel="noreferrer">{currentWork.citation}</a>
			</p>
		</section>

		<section class="section-card work-card" id="work">
			<h2 class="section-title">Publications</h2>
			<a href={featured.url} class="featured-paper" target="_blank" rel="noreferrer">
				<div class="featured-paper__figure">
					<img src={featured.image} alt={featured.imageAlt} loading="lazy" decoding="async" />
				</div>
				<div class="featured-paper__text">
					<h3>{featured.title} <span class="item-year">{featured.year}</span></h3>
					<p class="paper-citation">{featured.citation}</p>
					<p>{featured.description}</p>
				</div>
			</a>
			{selectedPapers.map((paper) => (
				<a href={paper.url} class="review-card" target="_blank" rel="noreferrer">
					<div class:list={['review-card__figure', paper.figureClass]}>
						<img src={paper.image} alt={paper.imageAlt} loading="lazy" decoding="async" />
					</div>
					<div class="review-card__text">
						<h3>{paper.title} <span class="item-year">{paper.year}</span></h3>
						<p class="paper-citation">{paper.citation}</p>
						<p>{paper.description}</p>
					</div>
				</a>
			))}
			<div class="highlight-grid">
				{highlights.map((item) => (
					<a href={item.url} class="highlight-card" target="_blank" rel="noreferrer">
						<h3>{item.title} <span class="item-year">{item.year}</span></h3>
						<p class="paper-citation">{item.citation}</p>
						<p>{item.description}</p>
					</a>
				))}
			</div>
		</section>

		<section class="section-card tutorials-card" id="teaching">
			<h2 class="section-title">Selected tutorials</h2>
			<div class="tutorials-card__list">
				{tutorialLinks.map((item) => (
					<a href={item.url} class="tutorials-card__entry" target="_blank" rel="noreferrer">
						<div class="tutorials-card__photo">
							<img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
						</div>
						<div class="tutorials-card__text">
							<h3>{item.title} <span class="item-year">{item.year}</span></h3>
							<p>{item.description}</p>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="section-card creative-card" id="music">
			<div class="creative-card__text">
				<h2 class="section-title">Creative Side Quests</h2>
				<p class="section-lede">
					Guitar has been a lifelong hobby. I keep a public profile of my playing at
					<a href={instagramLink} target="_blank" rel="noreferrer">@gagedezoort.music</a>.
				</p>
			</div>
			<div class="creative-card__media">
				{creativePhotos.map((photo) => (
					<div class={photo.className}>
						<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
					</div>
				))}
			</div>
		</section>

		<section class="section-card connect" id="contact">
			<h2 class="section-title">Contact</h2>
			<ul class="connect-list">
				{connections.map((link) => (
					<li>
						<a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<style>
	.hero {
		position: relative;
		display: grid;
		gap: clamp(1.8rem, 3.2vw, 3.6rem);
		grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
		align-items: center;
		max-width: var(--max-width);
		margin: 0 auto clamp(2.2rem, 4.5vw, 3.6rem);
		padding: clamp(0.8rem, 2vw, 1.6rem) 0;
	}

	.hero__name {
		margin: 0;
		font-family: inherit;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--text);
		line-height: 1.05;
	}

	.hero__role {
		margin: 0.55rem 0 0;
		font-weight: 500;
		font-size: clamp(0.92rem, 1.1vw, 1.02rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(243, 244, 249, 0.62);
	}

	.hero__bio {
		margin: 1rem 0 1.4rem;
		max-width: 34rem;
		font-size: clamp(1.02rem, 1.2vw, 1.12rem);
		line-height: 1.65;
		color: var(--text-soft);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.62rem 1.25rem;
		border-radius: 999px;
		font-weight: 560;
		font-size: 0.92rem;
		border: 1px solid transparent;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.button--primary {
		background: var(--accent);
		color: #1a202a;
	}

	.button--primary:hover,
	.button--primary:focus-visible {
		color: #1a202a;
		background: #f7c48a;
	}

	.button--ghost {
		color: var(--text-soft);
		border-color: rgba(255, 255, 255, 0.12);
		background: transparent;
	}

	.button--ghost:hover,
	.button--ghost:focus-visible {
		border-color: rgba(255, 255, 255, 0.22);
		color: var(--text);
	}

	.hero__portrait {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero__frame {
		position: relative;
		padding: clamp(0.65rem, 1.5vw, 1.15rem);
		border-radius: 26px;
		background: var(--surface-strong);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: 0 24px 60px rgba(8, 12, 20, 0.32);
		z-index: 1;
	}

	.hero__frame img {
		display: block;
		width: clamp(210px, 26vw, 300px);
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: 58% 20%;
		border-radius: 18px;
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: clamp(1.6rem, 3vw, 2.8rem);
		max-width: var(--max-width);
		margin: 0 auto clamp(2.5rem, 6vw, 4rem);
	}

	.work-card {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}

	.work-card .section-title,
	.ongoing-card .section-title,
	.tutorials-card .section-title,
	.creative-card .section-title,
	.connect .section-title {
		margin-bottom: 0;
	}

	.ongoing-card__title {
		margin: 0.85rem 0 0;
		font-size: 1.12rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.ongoing-card__lede {
		margin: 0.7rem 0 0;
		max-width: 46rem;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--text-soft);
	}

	.ongoing-card__apps {
		display: grid;
		gap: 1.15rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 1.15rem;
	}

	.ongoing-card__apps h4 {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--text);
	}

	.ongoing-card__apps p {
		margin: 0.4rem 0 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-soft);
	}

	.ongoing-card__link {
		margin: 1.1rem 0 0;
	}

	.ongoing-card__link a {
		color: var(--text-soft);
		font-weight: 500;
	}

	.ongoing-card__link a:hover,
	.ongoing-card__link a:focus-visible {
		color: var(--accent);
	}

	.featured-paper,
	.review-card,
	.highlight-card,
	.tutorials-card__entry {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.35rem;
		border-radius: 20px;
		border: 1px solid var(--border);
		background: var(--surface-strong);
		box-shadow: 0 12px 28px rgba(8, 12, 20, 0.22);
		color: inherit;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.featured-paper {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1.1rem, 2.2vw, 1.8rem);
		align-items: center;
		padding: 1.05rem 1.45rem 1.05rem 1.05rem;
	}

	.featured-paper__text,
	.review-card__text,
	.tutorials-card__text {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.35rem 0.2rem;
	}

	.featured-paper__figure,
	.review-card__figure {
		border-radius: 14px;
		overflow: hidden;
		background: #f7f5f1;
		width: min(200px, 32vw);
		max-height: 168px;
		flex-shrink: 0;
	}

	.featured-paper__figure img,
	.review-card__figure img {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 168px;
		object-fit: contain;
	}

	.featured-paper h3,
	.review-card h3,
	.highlight-card h3,
	.tutorials-card__text h3 {
		margin: 0;
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.featured-paper p,
	.review-card p,
	.highlight-card p,
	.tutorials-card__text p {
		margin: 0;
		color: var(--text-soft);
		line-height: 1.6;
		font-size: 1rem;
	}

	.item-year {
		font-weight: 500;
		font-size: 0.78em;
		color: rgba(196, 201, 215, 0.62);
		letter-spacing: 0.02em;
	}

	.item-year::before {
		content: '· ';
	}

	.paper-citation {
		font-size: 0.92rem !important;
		color: rgba(243, 244, 249, 0.62) !important;
		line-height: 1.5 !important;
	}

	.featured-paper:hover,
	.featured-paper:focus-visible,
	.review-card:hover,
	.review-card:focus-visible,
	.highlight-card:hover,
	.highlight-card:focus-visible,
	.tutorials-card__entry:hover,
	.tutorials-card__entry:focus-visible {
		transform: translateY(-3px);
		box-shadow: 0 24px 48px rgba(8, 12, 20, 0.36);
		color: inherit;
	}

	.featured-paper:hover h3,
	.featured-paper:focus-visible h3,
	.review-card:hover h3,
	.review-card:focus-visible h3,
	.highlight-card:hover h3,
	.highlight-card:focus-visible h3,
	.tutorials-card__entry:hover h3,
	.tutorials-card__entry:focus-visible h3 {
		color: var(--accent);
	}

	.review-card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1rem, 2vw, 1.6rem);
		align-items: center;
		padding: 1rem;
	}

	.review-card__figure {
		background: #efe6d4;
		width: min(180px, 30vw);
	}

	.review-card__figure img {
		object-fit: contain;
		background: #efe6d4;
	}

	.review-card__figure--plot {
		background: #f7f5f1;
	}

	.review-card__figure--plot img {
		background: #f7f5f1;
	}

	.highlight-grid {
		display: grid;
		gap: 1.15rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.tutorials-card__list {
		display: grid;
		gap: 1.15rem;
		margin-top: 0.85rem;
	}

	.tutorials-card__entry {
		display: grid;
		grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
		gap: clamp(0.9rem, 2vw, 1.4rem);
		align-items: center;
		padding: 0.9rem;
	}

	.tutorials-card__photo {
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.tutorials-card__photo img {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 180px;
		object-fit: cover;
	}

	.creative-card {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
		gap: clamp(1.2rem, 2.4vw, 2rem);
		align-items: center;
	}

	.creative-card__text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.creative-card .section-lede {
		margin: 0;
		color: var(--text-soft);
		max-width: 28rem;
	}

	.creative-card .section-lede a {
		color: var(--text-soft);
	}

	.creative-card .section-lede a:hover,
	.creative-card .section-lede a:focus-visible {
		color: var(--accent);
	}

	.creative-card__media {
		position: relative;
		min-height: clamp(160px, 22vw, 210px);
	}

	.creative-card__photo {
		position: absolute;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 18px 36px rgba(8, 12, 20, 0.32);
	}

	.creative-card__photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.creative-card__photo--one {
		top: 8%;
		left: 0;
		width: 48%;
		height: 72%;
		transform: rotate(-2deg);
	}

	.creative-card__photo--two {
		top: 0;
		right: 6%;
		width: 46%;
		height: 68%;
		transform: rotate(3deg);
		z-index: 1;
	}

	.creative-card__photo--three {
		bottom: 0;
		left: 28%;
		width: 42%;
		height: 58%;
	}

	.connect {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.8rem 2rem;
	}

	.connect-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
		align-items: center;
	}

	.connect-list a {
		color: var(--text-soft);
		font-weight: 500;
	}

	.connect-list a:hover,
	.connect-list a:focus-visible {
		color: var(--accent);
	}

	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero__portrait {
			order: -1;
		}

		.featured-paper,
		.review-card,
		.tutorials-card__entry,
		.creative-card,
		.highlight-grid,
		.ongoing-card__apps {
			grid-template-columns: 1fr;
		}

		.featured-paper {
			padding: 1rem;
		}

		.creative-card__media {
			min-height: clamp(180px, 48vw, 230px);
		}
	}

	@media (max-width: 640px) {
		.hero__frame img {
			width: clamp(200px, 70vw, 280px);
		}

		.creative-card__photo--one,
		.creative-card__photo--two,
		.creative-card__photo--three {
			transform: none;
		}
	}
</style>
